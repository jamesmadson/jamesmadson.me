<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light dark">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="James Madson">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="canonical" href="https://jamesmadson.me{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://jamesmadson.me{{ page.url }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://jamesmadson.me/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="James Madson">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://jamesmadson.me/img/og-image.png">

  <link rel="icon" href="/icons/favicon.ico?v={{ build.version }}" sizes="32x32">
  <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg?v={{ build.version }}">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png?v={{ build.version }}">
  <link rel="manifest" href="/icons/site.webmanifest">
  <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#282829">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="theme-color" content="#ffffff">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">

  <link rel="stylesheet" type="text/css" href="/assets/css/styles.css?v={{ build.version }}">

  <script>!function(){var e=document.documentElement,t=localStorage.getItem("theme")||(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");e.className=e.className.replace(/\btheme-\S+/g,"");e.classList.add("theme-"+t)}();</script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HL3TB4H7XS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HL3TB4H7XS');
  </script>
</head>
<body>
  {% set activeNav = 'work' %}
  {% include "partials/site-nav.njk" %}

  <header class="fadeIn about_header">
    <div class="container">
      <div class="grid_3">
        <h1 class="fadeIn jm_title">{{ title }}</h1>
      </div>
      <div class="grid_9 about_header_meta">
        <p class="about_meta">{{ company }}{% if status %} · {{ status }}{% endif %}</p>
      </div>
    </div>
  </header>

  <main class="fadeIn project_preview" id="main-content">
    <div class="container">
      <div class="grid_12">
        <p class="project_preview_back"><a href="/work/#projects" class="view_project">← All projects</a></p>
      </div>
    </div>
    <div class="container project_preview_grid">
      {% include "partials/work-card-project-preview.njk" %}
    </div>
  </main>

  {% include "partials/footer.njk" %}
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
