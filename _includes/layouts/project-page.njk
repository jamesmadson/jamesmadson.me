---
layout: base.njk
activeNav: work
---
{# Coming-soon project stubs: a card preview and a route back to Work.
   The head lives in base.njk; pageTitle/description come from each stub. #}
  <header class="fadeIn about_header">
    <div class="container">
      <div class="grid_3">
        <h1 class="fadeIn jm_title">{{ title }}</h1>
      </div>
      <div class="grid_9 about_header_meta">
        <p class="about_meta">{{ company }}{% if status %} · {{ status }}{% endif %}</p>
      </div>
    </div>
  </header>

  <main class="fadeIn project_preview" id="main-content">
    <div class="container">
      <div class="grid_12">
        <p class="project_preview_back"><a href="/work/" class="view_project">← Work</a></p>
      </div>
    </div>
    <div class="container project_preview_grid">
      {% include "partials/work-card-project-preview.njk" %}
    </div>
  </main>
